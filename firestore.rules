rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function branchMember(branchId) {
      return signedIn() && request.auth.token.branch_id == branchId;
    }

    function branchManager(branchId) {
      return branchMember(branchId)
        && request.auth.token.role in ['OWNER', 'MANAGER'];
    }

    match /sync_batches/{branchId}/batches/{batchId} {
      allow read: if branchManager(branchId);
      allow create: if branchMember(branchId)
        && request.resource.data.branchId == branchId
        && request.resource.data.batchId == batchId
        && request.resource.data.eventCount is int
        && request.resource.data.eventCount > 0
        && request.resource.data.eventCount <= 100
        && request.resource.data.compressedPayload is string;
      allow update, delete: if false;
    }

    match /daily_summaries/{summaryId} {
      allow read: if signedIn()
        && request.auth.token.role in ['OWNER', 'MANAGER']
        && request.auth.token.branch_id == resource.data.branchId;
      allow create, update: if signedIn()
        && request.auth.token.role in ['OWNER', 'MANAGER']
        && request.auth.token.branch_id == request.resource.data.branchId
        && request.resource.data.dateKey is string;
      allow delete: if false;
    }

    match /master_catalog/{catalogId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.token.role in ['OWNER', 'MANAGER']
        && request.auth.token.branch_id == request.resource.data.branchId;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}