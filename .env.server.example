# Copy this file to .env.server and replace every example value.
# Never commit .env.server or production credentials.
POSTGRES_DB=supermarket
POSTGRES_USER=supermarket
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_PORT=5432
API_PORT=8080

# Branch-scoped bearer tokens. Keep this JSON on one line.
# Generate a separate high-entropy token per branch and rotate it periodically.
ERP_BRANCH_TOKENS={"branch-main":"replace-with-a-long-random-branch-token"}

# Optional during the staged rollout. These values point to the separate
# control-plane database and a least-privilege runtime login, never a store DB.
# The control-plane migration must be applied separately before enabling these.
CONTROL_PLANE_PGHOST=127.0.0.1
CONTROL_PLANE_PGPORT=5432
CONTROL_PLANE_PGDATABASE=supermarket_control
CONTROL_PLANE_PGUSER=supermarket_control_runtime
CONTROL_PLANE_PGPASSWORD=replace-with-secret-manager-managed-password
