# Copy this file to .env.server and replace every example value.
# Never commit .env.server or production credentials.
POSTGRES_DB=supermarket
POSTGRES_USER=supermarket
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_PORT=5432
API_PORT=8080

# Branch-scoped bearer tokens. Keep this JSON on one line.
# Generate a separate high-entropy token per branch and rotate it periodically.
ERP_BRANCH_TOKENS={"branch-main":"replace-with-a-long-random-branch-token"}
